{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "logResults",
  "type": "object",
  "properties": {
    "cqlengine": {
      "type": "object",
      "properties": {
        "apiUrl": { "type": "string" },
        "description": { "type": "string" },
        "cqlVersion": { "type": "string" },
        "cqlTranslator": { "type": "string" },
        "cqlTranslatorVersion": { "type": "string" },
        "cqlEngine": { "type": "string" },
        "cqlEngineVersion": { "type": "string" }
      },
      "required": ["apiUrl", "description", "cqlVersion", "cqlTranslator", "cqlTranslatorVersion", "cqlEngine", "cqlEngineVersion"]
    },
    "testResultsSummary": {
      "type": "object",
      "properties": {
        "passCount": { "type": "integer" },
        "skipCount": { "type": "integer" },
        "failCount": { "type": "integer" },
        "errorCount": { "type": "integer" }
      },
      "required": ["passCount", "skipCount", "failCount", "errorCount"]
    },
    "testsRunDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "testsRunDescription": {
      "type":  "string"
    },
    "evaluationRequest": {
      "type": "object",
      "description": "How evaluation requests were timed, and whether the server acted on it. Probed once per run; null means it could not be determined.",
      "properties": {
        "defaultTimezoneOffset": {
          "type": "string",
          "description": "The timezone offset used for tests that specify neither evaluationDateTime nor evaluationTimezoneOffset."
        },
        "timestampParameterHonored": {
          "type": ["boolean", "null"],
          "description": "Whether the server used the timestamp operation parameter as the evaluation request timestamp."
        },
        "timezoneHeaderHonored": {
          "type": ["boolean", "null"],
          "description": "Whether the server used the Timezone (client-timezone) HTTP header as the evaluation timezone offset."
        },
        "serverTimezoneOffset": {
          "type": ["string", "null"],
          "description": "The offset the server evaluates at when it honours neither mechanism, as observed by the probe. When set, DateTimes a test writes without an offset are compared at this offset, since it is the one the evaluation actually ran at."
        }
      },
      "required": ["defaultTimezoneOffset", "timestampParameterHonored", "timezoneHeaderHonored"]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "testStatus": {
            "type": "string",
            "enum": ["pass", "fail", "skip", "error"]
          },
          "responseStatus": {
            "type": "integer"
          },
          "actual": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "name": { "type": "string" },
              "stack": { "type": "string" }
            },
            "required": ["message"]
          },
          "testsName": {
            "type": "string"
          },
          "groupName": {
            "type": "string"
          },
          "testName": {
            "type": "string"
          },
          "invalid": {
            "type": "string",
            "enum": ["true", "false", "semantic"]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code":   { "type": "string" },
                "value":  {
                  "anyOf": [
                    { "type": "boolean" },
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "object" },
                    { "type": "array" }
                  ]
                },
                "system":  { "type": "string" },
                "display": { "type": "string" },
                "version": { "type": "string" }
              },
              "required": ["code"]
            }
          },
          "expression": {
            "type": "string"
          },
          "evaluationTimestamp": {
            "type": "string",
            "format": "date-time",
            "description": "The evaluation request timestamp sent to the server for this test."
          }
        },
        "required": ["testsName", "groupName", "testName", "expression"]
      }
    }
  },
  "required": ["cqlengine", "testResultsSummary", "testsRunDateTime", "results"]
}
